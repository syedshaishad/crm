APP_NAME="CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

# Set to true on first upload. Installer auto-flips to false + writes installed.lock on completion.
APP_INSTALLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
# Production HTTPS only: true (local HTTP logins break with true).
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# White-label defaults (overridable from Settings > Branding UI after install; .env is only the seed)
BRAND_COMPANY_NAME=
BRAND_TAGLINE=
BRAND_PRIMARY_COLOR=#4f46e5
BRAND_ACCENT_COLOR=#06b6d4
BRAND_LOGO_PATH=
BRAND_FAVICON_PATH=
BRAND_LOGIN_HEADING=
BRAND_LOGIN_SUBTEXT=

# Tax / GST defaults (India-ready, editable per installation)
TAX_DEFAULT_GST_RATE=18
TAX_ENABLE_GST=true
TAX_CGST_SGST_SPLIT=true

# Razorpay (per-installation keys; leave empty to disable online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Licensing — Licensify server (license.shaishad.com). The app stays locked
# until a reseller-issued key is activated (installer step, Settings, or CLI).
# API credentials are provisioned per install by the reseller; never ship a
# buyer's LICENSE_KEY inside a distributed zip.
LICENSE_SERVER_URL=https://license.shaishad.com
LICENSE_PRODUCT_CODE=CRM
LICENSE_KEY=
LICENSE_API_KEY=
LICENSE_API_SECRET=
LICENSE_TIMEOUT=10
LICENSE_VERIFY_SSL=true
LICENSE_REVALIDATE_MINUTES=60

# Updates
APP_VERSION=1.0.8
UPDATE_BACKUP_BEFORE_UPDATE=true
UPDATE_PACKAGE_DIR=storage/app/updates
